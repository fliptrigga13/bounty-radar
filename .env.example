# Bounty Radar environment template.
# Copy to .env.local, fill in real values, never commit .env.local.

# Delivery channel: "discord" or "telegram"
RADAR_CHANNEL=discord

# Discord incoming webhook (Channel > Integrations > Webhooks > Copy URL)
# Secret Manager Name: bounty-radar-discord-webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram bot credentials (alternative to Discord)
# Secret Manager Name: bounty-radar-telegram-token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret Manager Name: bounty-radar-telegram-chat-id
TELEGRAM_CHAT_ID=000000000

# Polling configuration
RADAR_DB=radar.db
RADAR_INTERVAL_SEC=3600

# A2A JSON-RPC server configuration
A2A_PORT=8080
# Public URL advertised in Agent Card (when deployed behind HTTPS)
A2A_PUBLIC_URL=http://localhost:8080/a2a

# Google Cloud Deployment (Optional overrides for deploy-cloudrun scripts)
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_REPO_NAME=bounty-radar
GCP_SERVICE_NAME=bounty-radar
GCP_GCS_BUCKET=
